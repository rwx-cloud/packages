#!/bin/sh
set -e

orig_dir=$(pwd -P)
mkdir -p "${CHECKOUT_PATH}"
checkout_abs=$(cd "${CHECKOUT_PATH}" && pwd -P)
git_dir_path="${checkout_abs%/}/.git"

case "$git_dir_path" in
  "${orig_dir}")
    rel_path="."
    ;;
  "${orig_dir}/"*)
    rel_path="${git_dir_path#"${orig_dir}/"}"
    ;;
  *)
    rel_path="$git_dir_path"
    ;;
esac

printf '%s\n' "$rel_path" > "$RWX_VALUES/git-dir-path"
cd "${CHECKOUT_PATH}"

GIT_CLONE_CHECKOUT_REF=refs/rwx/git-clone/checkout

if [ ! -d .git ]; then
  git init -b main
  git remote add origin "${CHECKOUT_REPOSITORY}"
fi

# Reset helpers inherited from the base image or an older tool-cache entry.
git config --local --replace-all credential.helper ''
if [ -n "${CREDENTIAL_HELPER}" ]; then
  git config --local --add credential.helper "${CREDENTIAL_HELPER}"
fi

# Avoid background maintenance rewriting packfiles in incremental tool-cache runs.
git config --local maintenance.auto false
git config --local gc.auto 0
git config --local core.trustctime false

if git rev-parse -q --verify HEAD^{commit} >/dev/null 2>&1; then
  git update-ref refs/rwx/git-clone/previous HEAD
fi

if [ "${FETCH_FULL_DEPTH}" = "true" ]; then
  git fetch --no-auto-gc origin "+${CHECKOUT_REF}:${GIT_CLONE_CHECKOUT_REF}"
elif [ "${PRESERVE_GIT_DIR}" = "true" ]; then
  git fetch --no-auto-gc --depth=1 origin "+${CHECKOUT_REF}:${GIT_CLONE_CHECKOUT_REF}"
else
  git fetch --no-auto-gc --depth=1 origin "+${RESOLVED_SHA}:${GIT_CLONE_CHECKOUT_REF}"
fi

checkout_sha=$(git rev-parse "${GIT_CLONE_CHECKOUT_REF}^{commit}")

case "${RESOLVED_REF}" in
  refs/heads/*)
    branch_name="${RESOLVED_REF#refs/heads/}"
    git update-ref "refs/remotes/origin/${branch_name}" "${checkout_sha}"
    git checkout -B "${branch_name}" "${checkout_sha}"
    git config "branch.${branch_name}.remote" origin
    git config "branch.${branch_name}.merge" "${RESOLVED_REF}"
    ;;
  *)
    git checkout --detach "${checkout_sha}"
    ;;
esac

git update-ref "${GIT_CLONE_CHECKOUT_REF}" HEAD

# Remove untracked files that may remain from incremental cache
git clean -fd

commit_sha=$(git rev-parse HEAD | tr -d '\n')
echo "Checked out git repository at ${commit_sha}"

if [ "${SUBMODULES}" = "true" ] && [ -f .gitmodules ]; then
  git submodule sync --recursive
  if [ -n "${CREDENTIAL_HELPER}" ]; then
    git -c credential.helper= -c "credential.helper=${CREDENTIAL_HELPER}" submodule update --init --recursive
  else
    git submodule update --init --recursive
  fi

  echo "Submodules initialized and updated"
fi

if [ "${LFS}" = "true" ]; then
  LFS_FILES=$(git-lfs ls-files -n)
  if [ "${LFS_FILES}" != "" ]; then
    printf '%s\n' "$LFS_FILES" > "$RWX_VALUES/lfs-files"
    FILTER_PATH_PREFIX="${CHECKOUT_PATH%/}/"
    FILTER_LINES=$(printf '%s\n' "$LFS_FILES" | jq -c --raw-input --slurp --arg prefix "$FILTER_PATH_PREFIX" 'split("\n") | map(select(. != "") | $prefix + .)')

    LFS_ENDPOINT=$(git-lfs env | grep "Endpoint=" | awk -F'[ =]' '{print $2}')
    printf '%s' "$LFS_ENDPOINT" > "$RWX_VALUES/lfs-endpoint"
    cat << EOF > "$RWX_DYNAMIC_TASKS/lfs.yml"
- key: lfs-files
  use: cleanup-git-dir
  run: sh \$RWX_PACKAGE_PATH/bin/download-lfs-files
  env:
    CHECKOUT_REPOSITORY: \${{ params.repository }}
    GIT_SSH_KEY:
      value: \${{ params.ssh-key }}
      cache-key: excluded
    GITHUB_TOKEN:
      value: \${{ params.github-token }}
      cache-key: excluded
    CURSOR_ORIGIN_TOKEN:
      value: \${{ params.cursor-origin-token }}
      cache-key: excluded
    LFS_ENDPOINT: \${{ tasks.git-clone.values.lfs-endpoint }}
    LFS_FILES: \${{ tasks.git-clone.values.lfs-files }}
    CHECKOUT_PATH: \${{ params.path }}
    PRESERVE_GIT_DIR: \${{ params.preserve-git-dir }}
  filter: ${FILTER_LINES}
EOF
      if [ "${PRESERVE_GIT_DIR}" = "true" ]; then
        cat << EOF > "$RWX_DYNAMIC_TASKS/lfs-cleanup.yml"
- key: lfs-cleanup
  use: lfs-files
  run: git add -Av
EOF
    fi
  fi
fi

# Set metadata
printf '%s' "${CHECKOUT_REPOSITORY}" >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_REPOSITORY_URL"
printf '%s' "${CHECKOUT_REPOSITORY}" | tr ':' '/' | rev | cut -d '/' -f1,2 | rev | sed 's/\.git$//' >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_REPOSITORY_NAME"

commit_message=$(git log -n 1 --pretty=format:%B)
printf '%s' "${commit_message}" | head -c 1024 >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_COMMIT_MESSAGE"
printf '%s' "${commit_message}" | head -n 1 | tr -d '\n' | head -c 1024 >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_COMMIT_SUMMARY"

committer_name=$(git log -n 1 --pretty=format:%an)
printf '%s' "${committer_name}" >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_COMMITTER_NAME"

committer_email=$(git log -n 1 --pretty=format:%ae)
printf '%s' "${committer_email}" >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_COMMITTER_EMAIL"

unresolved_ref=""
if [ -n "${META_REF}" ]; then
  unresolved_ref="${META_REF}"
elif [ "${CHECKOUT_REF}" = "${commit_sha}" ]; then
  if ! ls_remote_output=$(git ls-remote --heads --tags origin 2>&1); then
    error_file=$(mktemp "$RWX_ERRORS/error-XXXXXX")
    cat << EOF > "$error_file"
Failed to query git remote for ref resolution. The git remote operation failed.
EOF
    exit 1
  fi
  if ! refs_with_sha_at_head=$(printf '%s\n' "$ls_remote_output" | awk "\$1 ~ /^${commit_sha}/" | awk '{ print $2; }'); then
    refs_with_sha_at_head=""
  fi
  unresolved_ref=$(printf '%s\n' "$refs_with_sha_at_head" | head -n 1 | tr -d '\n')
else
  if ! ls_remote_output=$(git ls-remote --heads --tags origin 2>&1); then
    error_file=$(mktemp "$RWX_ERRORS/error-XXXXXX")
    cat << EOF > "$error_file"
Failed to query git remote for ref resolution. The git remote operation failed.
EOF
    exit 1
  fi
  if ! refs_matching_provided_ref=$(printf '%s\n' "$ls_remote_output" | grep "refs/heads/${CHECKOUT_REF}\|refs/tags/${CHECKOUT_REF}\|${CHECKOUT_REF}" | awk '{ print $2; }'); then
    refs_matching_provided_ref=""
  fi
  unresolved_ref=$(printf '%s\n' "$refs_matching_provided_ref" | head -n 1 | tr -d '\n')
fi

if [ -z "${unresolved_ref}" ]; then
  unresolved_ref="${CHECKOUT_REF}"
fi

printf '%s' "${commit_sha}" >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_COMMIT_SHA"
printf '%s' "${unresolved_ref}" >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_REF"
printf '%s' "${unresolved_ref}" | sed -E 's|refs/[^/]+/||' >> "$RWX_CACHE_KEY_EXCLUDED_ENV/RWX_GIT_REF_NAME"

if [ "${PRESERVE_GIT_DIR}" = "true" ] && [ -n "$GITHUB_TOKEN" ]; then
  case "$CHECKOUT_REPOSITORY" in
    http://*|https://*|ssh://*)
      github_host=${CHECKOUT_REPOSITORY#*://}
      github_host=${github_host%%/*}
      github_host=${github_host##*@}
      case "$CHECKOUT_REPOSITORY" in ssh://*) github_host=${github_host%%:*} ;; esac
      ;;
    *:*) github_host=${CHECKOUT_REPOSITORY%%:*}; github_host=${github_host##*@} ;;
    *) echo "Cannot determine GitHub host from repository URL" >&2; exit 1 ;;
  esac
  github_host=$(printf '%s' "$github_host" | tr '[:upper:]' '[:lower:]')
  github_host=${github_host%:443}
  if [ "$github_host" = github.com ]; then
    graphql_url=https://api.github.com/graphql
  else
    graphql_url="https://$github_host/api/graphql"
  fi

  QUERY="query { viewer { databaseId login email } }"
  # Do not follow redirects with an installation token to another origin.
  ACCESS_TOKEN_DATA=$(curl \
    -fsS --proto '=https' \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -X POST \
    -d "{ \"query\": \"${QUERY}\"}" \
    "$graphql_url" \
  )

  GIT_USERNAME=$(printf '%s\n' "$ACCESS_TOKEN_DATA" | jq -er '.data.viewer.login | select(. != null and . != "")')
  if [ "$github_host" = github.com ]; then
    ACCESS_TOKEN_ID=$(printf '%s\n' "$ACCESS_TOKEN_DATA" | jq -er '.data.viewer.databaseId')
    GIT_EMAIL="${ACCESS_TOKEN_ID}+${GIT_USERNAME}@users.noreply.github.com"
  else
    GIT_EMAIL=$(printf '%s\n' "$ACCESS_TOKEN_DATA" | jq -r '.data.viewer.email // empty')
    GIT_EMAIL=${GIT_EMAIL:-${GIT_USERNAME}@${github_host%%:*}}
  fi

  git config user.email "$GIT_EMAIL"
  git config user.name "$GIT_USERNAME"
fi
